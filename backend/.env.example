# ---- Backend environment variables ----
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API server listens on
PORT=5000

# MongoDB connection string (local install shown; use your own for Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# Secret used to sign JWTs — use a long random string in real environments
JWT_SECRET=change_me_to_a_long_random_secret_string
# How long an issued token stays valid (e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# Redis connection URL for task caching (OPTIONAL).
# Leave unset to disable caching — the app falls back to the database.
REDIS_URL=redis://127.0.0.1:6379
